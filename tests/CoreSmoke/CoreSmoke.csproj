<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- 엔진 없는 규칙(Core), 엔진 없는 저작 규칙(Authoring), NUnit에 의존하지 않는 계약만 컴파일한다. -->
    <Compile Include="../../Assets/BlackHole/Core/**/*.cs" />
    <Compile Include="../../Assets/BlackHole/Authoring/**/*.cs" />
    <Compile Include="../../Assets/BlackHole/Tests/EditMode/Contracts/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
